# Shopify App Credentials
# Get these from your Shopify Partner Dashboard → App → API credentials
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here

# OAuth Scopes (comma-separated, no spaces)
SCOPES=write_orders,read_orders,write_products,read_products,read_customers,write_customers,read_shipping,read_draft_orders,write_draft_orders

# Your app's public URL (HTTPS required for production)
# During dev: Shopify CLI provides this via ngrok tunnel automatically
SHOPIFY_APP_URL=https://your-app-domain.fly.dev

# Database Connection String
# PostgreSQL example:
DATABASE_URL=postgresql://username:password@localhost:5432/smartcod
# Railway example: automatically set when you provision a PostgreSQL service
# Fly.io example: set when you attach a Postgres app

# Node.js Environment
NODE_ENV=development

# Optional: Custom Shopify shop domain (for testing on a specific store)
# SHOP_CUSTOM_DOMAIN=your-store.myshopify.com
